# GitHub token: required for the crawl (search API), and used to authenticate
# clones — GitHub throttles anonymous git per IP after a few thousand clones.
# Any token works; no permissions are needed for public repositories.
GITHUB_API_KEY=''

# Number of top TypeScript repositories to process.
REPO_SEARCH_BUDGET='1200'

# Directory holding the state database (e20r.db) and the work directory.
CACHE_PATH='.e20r'

# Set to 'true' for an in-memory database and a temporary work directory
# (nothing survives the run).
NO_CACHE='false'

# Repositories processed (cloned, selected, analyzed) in parallel (1-16).
# Network-bound: 4-8 is a good range; more only adds pressure on GitHub.
# Clones are blobless and sparse and are deleted as soon as a repository is
# committed, so disk usage stays around CONCURRENCY x the largest checkout.
CONCURRENCY='4'

# Failed repositories are retried on later runs up to this many attempts.
MAX_ATTEMPTS='3'

# Source files above this many bytes are scanned as text only.
MAX_PARSE_BYTES='1000000'

# Comma-separated owner/name list kept out of the deep analysis (the
# Effect-TS org is always excluded).
EXCLUDE_REPOS=''

# Also exclude repositories that define an `effect` or `@effect/*` package
# (vendored copies or mirrors of Effect).
EXCLUDE_EFFECT_COPIES='true'
