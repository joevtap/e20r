{
    "name": "e20r",
    "description": "effect-adoption-analyzer (e20r) - a CLI program built to mine information about the Effect library adoption in TypeScript FOSS software hosted in GitHub.",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch",
        "prestart": "pnpm run build",
        "start": "node dist/index.js",
        "e20r": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "tsx": "tsx"
    },
    "devDependencies": {
        "@effect/language-service": "0.87.1",
        "@effect/tsgo": "^0.24.3",
        "@types/node": "26.1.2",
        "effect-solutions": "^0.5.3",
        "tsx": "4.23.1",
        "typescript": "7.0.2"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.19.0",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@effect/platform-node": "4.0.0-beta.102",
        "effect": "4.0.0-beta.102"
    }
}
