{
    "name": "e12r",
    "description": "effect-analyzer (e12r) - a CLI program built to mine information about the Effect library adoption in TypeScript FOSS software hosted in GitHub.",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "prestart": "pnpm run build",
        "start": "node dist/index.js",
        "e12r": "node dist/index.js",
        "dev": "tsx src/index.ts"
    },
    "devDependencies": {
        "@effect/language-service": "0.87.1",
        "@types/node": "26.1.2",
        "tsx": "4.23.1",
        "typescript": "7.0.2"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.5.1",
            "onFail": "download"
        }
    },
    "dependencies": {
        "@effect/platform-node": "4.0.0-beta.102",
        "effect": "4.0.0-beta.102"
    }
}
