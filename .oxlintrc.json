{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "reportUnusedDisableDirectives": "warn"
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }]
  }
}
