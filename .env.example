GITHUB_API_KEY=''

REPO_SEARCH_BUDGET='1200'

# Local cache directory for search results, analyses, and repository clones.
CACHE_PATH='.e20r'

# Set to 'true' to disable reading and writing the cache (memory-only run).
NO_CACHE='false'

# Set to 'true' to delete repository clones after their analysis completes.
EPHEMERAL='false'

# Number of repositories cloned and analyzed in parallel (1-64).
CLONE_CONCURRENCY='4'
